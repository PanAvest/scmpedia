{
  "expo": {
    "name": "SCMpedia",
    "slug": "scmpedia-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/scmpedia/logo2.png",
    "scheme": "scmpedia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/scmpedia/logo2.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAF9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scmpedia.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SCMpedia uses audio features for native voice reading.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.scmpedia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/scmpedia/logo2.png",
        "backgroundColor": "#F7FAF9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font"
    ]
  }
}
